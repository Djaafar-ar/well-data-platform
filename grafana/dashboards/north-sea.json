          "uid": "wellsdb"
        },
        "query": "SELECT DISTINCT l.log_id AS __value, l.wellbore AS __text\nFROM core.well_logs l JOIN core.log_curves c USING (log_id)\nWHERE c.family = 'Lithology (interpreted)'\nORDER BY 2",
        "definition": "SELECT DISTINCT l.log_id AS __value, l.wellbore AS __text FROM core.well_logs l JOIN core.log_curves c USING (log_id) WHERE c.family = 'Lithology (interpreted)' ORDER BY 2",
