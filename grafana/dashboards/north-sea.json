    {
      "id": 8,
      "type": "piechart",
      "title": "Rock composition of $well_log (metres, interpreted lithology)",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT lithology, round(sum(thickness_m)) AS metres\nFROM core.lithology_intervals\nWHERE log_id = $well_log\nGROUP BY lithology\nORDER BY metres DESC"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^metres$/",
          "values": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Lithology intervals of $well_log (top to bottom)",
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(top_m::numeric, 1) AS top_m, round(base_m::numeric, 1) AS base_m,\n       round(thickness_m::numeric, 1) AS thickness_m, lithology\nFROM core.lithology_intervals\nWHERE log_id = $well_log AND thickness_m >= 1\nORDER BY top_m\nLIMIT 500"
        }
      ]
    },
    {
      "id": 10,
      "type": "trend",
      "title": "Gamma ray vs depth: $well_log (sand low, shale high)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.depth_m, s.value AS \"Gamma ray\"\nFROM core.log_samples s\nJOIN core.log_curves c USING (log_id, mnemonic)\nWHERE s.log_id = $well_log AND c.family = 'Gamma ray'\n  AND c.mnemonic = (SELECT mnemonic FROM core.log_curves\n                    WHERE log_id = $well_log AND family = 'Gamma ray' ORDER BY n_valid DESC LIMIT 1)\nORDER BY s.depth_m"
        }
      ],
      "options": {
        "xField": "depth_m",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "All wells: data held and quality",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.wellbore, CASE WHEN m.is_synthetic THEN 'synthetic' ELSE 'real' END AS data,\n       round(m.latitude::numeric, 3) AS latitude, round(m.longitude::numeric, 3) AS longitude,\n       m.logs, round(m.deepest_log_m) AS deepest_log_m, m.has_lithology, m.has_production,\n       (SELECT sum(c.n_valid) FROM core.log_curves c JOIN core.well_logs l USING (log_id) WHERE l.wellbore = m.wellbore) AS log_values,\n       (SELECT sum(c.n_out_of_range) FROM core.log_curves c JOIN core.well_logs l USING (log_id) WHERE l.wellbore = m.wellbore) AS out_of_range\nFROM core.well_map m\nORDER BY m.is_synthetic, m.wellbore"
        }
      ]
    }
  ]
