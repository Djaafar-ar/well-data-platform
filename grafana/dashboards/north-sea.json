    {
      "id": 7,
      "type": "geomap",
      "title": "Wells with a known location (Norwegian North Sea)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT wellbore, latitude, longitude, logs, round(deepest_log_m) AS deepest_log_m,\n       has_lithology, has_production\nFROM core.well_map\nWHERE latitude IS NOT NULL"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 59.6,
          "lon": 3.0,
          "zoom": 5.3,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
