            "type": "markers",
            "name": "Wells",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "orange"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "field",
                  "field": "wellbore",
                  "fixed": ""
                },
                "textConfig": {
