{
  "uid": "well-overview",
  "title": "Well Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "wells",
    "scada"
  ],
  "templating": {
    "list": [
      {
        "name": "well",
        "label": "Well",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wellsdb"
        },
        "query": "SELECT well_id FROM core.wells ORDER BY 1",
        "definition": "SELECT well_id FROM core.wells ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "tag",
        "label": "Tag",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wellsdb"
        },
        "query": "SELECT tag FROM core.tags ORDER BY 1",
        "definition": "SELECT tag FROM core.tags ORDER BY 1",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "WHP",
          "value": "WHP"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$tag by well",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", well_id AS metric, value\nFROM core.readings\nWHERE $__timeFilter(time) AND tag = '$tag' AND well_id IN ($well)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest value and data freshness",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT well_id, tag, round(value::numeric, 2) AS value, unit, time AS last_seen,\n       extract(epoch FROM age)::int AS age_seconds\nFROM core.latest_readings\nWHERE well_id IN ($well)\nORDER BY age_seconds DESC, well_id, tag"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age_seconds"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Alarms (outside operating limits)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, well_id, tag, round(value::numeric, 2) AS value, unit, level\nFROM core.alarms\nWHERE $__timeFilter(time) AND well_id IN ($well)\nORDER BY time DESC\nLIMIT 200"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rejected readings (share of total)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * rej / NULLIF(rej + ok, 0) AS rejected_pct\nFROM (SELECT count(*) AS rej FROM raw.rejected WHERE $__timeFilter(time)) a,\n     (SELECT count(*) AS ok  FROM core.readings  WHERE $__timeFilter(time)) b"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Rejection reasons",
      "gridPos": {
        "x": 6,
        "y": 18,
        "w": 18,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT regexp_replace(reason, '-?[0-9][0-9.e+-]*', 'N', 'g') AS reason, count(*) AS readings\nFROM raw.rejected\nWHERE $__timeFilter(time)\nGROUP BY 1\nORDER BY 2 DESC"
        }
      ]
    }
  ]
}