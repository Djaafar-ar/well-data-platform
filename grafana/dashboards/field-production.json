{
  "uid": "field-production",
  "title": "Field Production",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-20y",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "wells",
    "production"
  ],
  "templating": {
    "list": [
      {
        "name": "wellbore",
        "label": "Wellbore",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wellsdb"
        },
        "query": "SELECT DISTINCT wellbore FROM core.daily_production ORDER BY 1",
        "definition": "SELECT DISTINCT wellbore FROM core.daily_production ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily oil production by wellbore (Sm3/d)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT prod_date::timestamptz AS \"time\", wellbore AS metric, oil_sm3 AS value\nFROM core.daily_production\nWHERE $__timeFilter(prod_date) AND wellbore IN ($wellbore) AND flow_kind = 'production'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Water cut, weekly average (%)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('week', prod_date)::timestamptz AS \"time\", wellbore AS metric,\n       avg(water_cut_pct) AS value\nFROM core.production_kpis\nWHERE $__timeFilter(prod_date) AND wellbore IN ($wellbore) AND water_cut_pct IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Cumulative production in period (Sm3)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT wellbore, round(sum(oil_sm3)) AS oil, round(sum(water_sm3)) AS water, round(sum(water_inj_sm3)) AS water_injected\nFROM core.daily_production\nWHERE $__timeFilter(prod_date) AND wellbore IN ($wellbore)\nGROUP BY wellbore\nORDER BY oil DESC"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Load runs (lineage)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT run_id, source_name, status, started_at, rows_read, rows_loaded, rows_rejected, rows_flagged,\n       left(file_sha256, 12) AS file_fingerprint\nFROM core.load_runs\nORDER BY run_id DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "skipped": {
                        "color": "blue",
                        "index": 2
                      },
                      "running": {
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Rejected and flagged rows (data quality)",
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wellsdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wellsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'rejected' AS outcome, regexp_replace(reason, '(?<![A-Za-z_])-?[0-9][0-9.e+-]*', 'N', 'g') AS reason, count(*) AS rows\nFROM raw.production_rejected\nWHERE run_id = (SELECT max(run_id) FROM core.load_runs WHERE status = 'succeeded')\nGROUP BY 2\nUNION ALL\nSELECT 'flagged', quality_flag, count(*)\nFROM core.daily_production\nWHERE quality_flag IS NOT NULL\nGROUP BY 2\nORDER BY 3 DESC"
        }
      ]
    }
  ]
}