# Copy this file to .env and change every password.
# .env is listed in .gitignore: it must never be committed.

POSTGRES_USER=wells_admin
POSTGRES_PASSWORD=change-me-admin
INGEST_PASSWORD=change-me-ingest
GRAFANA_DB_PASSWORD=change-me-reader
GRAFANA_ADMIN_PASSWORD=change-me-grafana
LOADER_PASSWORD=change-me-loader

# Alert emails (optional). Without SMTP, alerts still appear in Grafana under Alerting.
# Gmail: SMTP_HOST=smtp.gmail.com:587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<an App Password>
ALERT_EMAIL=you@example.com
SMTP_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

INTERVAL_SECONDS=10
FAULT_RATE=0.02
